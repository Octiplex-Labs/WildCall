    "WildCall est gratuit et sans publicité. Si l'app vous est utile, vous pouvez laisser un pourboire — c'est totalement optionnel." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "WildCall is free and ad-free. If the app is useful to you, you can leave a tip — it's entirely optional." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "WildCall es gratis y sin anuncios. Si la app te resulta útil, puedes dejar una propina — es completamente opcional." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "WildCall est gratuit et sans publicité. Si l'app vous est utile, vous pouvez laisser un pourboire — c'est totalement optionnel." } },

    "Les packs désactivés ne contribuent plus à la liste de blocage. Les règles que vous avez ajoutées vous-même ne sont pas affectées." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Disabled packs no longer contribute to the block list. Rules you added yourself are unaffected." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los paquetes desactivados ya no contribuyen a la lista de bloqueo. Las reglas que añadiste tú no se ven afectadas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les packs désactivés ne contribuent plus à la liste de blocage. Les règles que vous avez ajoutées vous-même ne sont pas affectées." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I pack disattivati non contribuiscono più alla lista di blocco. Le regole che hai aggiunto tu non sono interessate." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Os packs desativados não contribuem mais para a lista de bloqueio. As regras que você adicionou continuam intactas." } }

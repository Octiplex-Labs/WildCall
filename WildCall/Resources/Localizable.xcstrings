    "Saisissez un motif comme `+33162*` pour bloquer toute une famille de numéros en une seule règle. Pas besoin d'ajouter chaque numéro manuellement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a pattern like `+33162*` to block a whole family of numbers in a single rule. No need to add each number manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un patrón como `+33162*` para bloquear toda una familia de números en una sola regla. No hace falta añadir cada número manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un motif comme `+33162*` pour bloquer toute une famille de numéros en une seule règle. Pas besoin d'ajouter chaque numéro manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un motivo come `+33162*` per bloccare un'intera famiglia di numeri con una sola regola. Non serve aggiungere ogni numero manualmente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um padrão como `+33162*` para bloquear uma família inteira de números em uma única regra. Sem precisar adicionar cada número manualmente."
          }
        }
      }
    },

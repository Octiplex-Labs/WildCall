    "Bloquez les appels indésirables avant même qu'ils ne sonnent. Démarchage, spam, faux numéros, appels IA… silencieusement filtrés." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Block unwanted calls before they even ring. Telemarketing, spam, fake numbers, AI calls… silently filtered." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Bloquea las llamadas no deseadas antes incluso de que suenen. Telemarketing, spam, números falsos, llamadas con IA… filtradas en silencio." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Bloquez les appels indésirables avant même qu'ils ne sonnent. Démarchage, spam, faux numéros, appels IA… silencieusement filtrés." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Blocca le chiamate indesiderate prima ancora che squillino. Telemarketing, spam, numeri falsi, chiamate con IA… filtrati silenziosamente." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Bloqueie chamadas indesejadas antes mesmo de tocarem. Telemarketing, spam, números falsos, chamadas com IA… filtrados silenciosamente." } }
      }
    },
    "WildCall est gratuit. Les pourboires sont optionnels mais appréciés." : {

    "L'export ne contient que les règles que vous avez ajoutées vous-même. Les packs Octiplex ne sont pas inclus — ils se réinstallent automatiquement à la synchronisation." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The export only contains rules you added yourself. Octiplex packs are not included — they reinstall automatically at sync." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La exportación solo contiene las reglas que añadiste tú. Los paquetes de Octiplex no se incluyen — se reinstalan automáticamente al sincronizar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'export ne contient que les règles que vous avez ajoutées vous-même. Les packs Octiplex ne sont pas inclus — ils se réinstallent automatiquement à la synchronisation." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L'esportazione contiene solo le regole che hai aggiunto tu. I pack Octiplex non sono inclusi — vengono reinstallati automaticamente durante la sincronizzazione." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A exportação contém apenas as regras que você mesmo adicionou. Os packs Octiplex não estão incluídos — eles são reinstalados automaticamente na sincronização." } }
      }
    },
    "La synchronisation récupère les nouveaux packs et les mises à jour depuis Octiplex." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sync fetches new packs and updates from Octiplex." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La sincronización descarga nuevos paquetes y actualizaciones desde Octiplex." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La synchronisation récupère les nouveaux packs et les mises à jour depuis Octiplex." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La sincronizzazione recupera nuovi pack e aggiornamenti da Octiplex." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A sincronização busca novos packs e atualizações da Octiplex." } }
      }
    },
    "Le pack doit être signé. Vous verrez l'empreinte du publisher avant d'accepter." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The pack must be signed. You'll see the publisher's fingerprint before accepting." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El paquete debe estar firmado. Verás la huella del editor antes de aceptar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le pack doit être signé. Vous verrez l'empreinte du publisher avant d'accepter." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il pack deve essere firmato. Vedrai l'impronta dell'editore prima di accettare." } },

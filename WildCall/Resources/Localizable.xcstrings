    "WildCall est gratuit et sans publicité. Si l'app vous est utile, vous pouvez laisser un pourboire — c'est totalement optionnel." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "WildCall is free and ad-free. If the app is useful to you, you can leave a tip — it's entirely optional." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "WildCall es gratis y sin anuncios. Si la app te resulta útil, puedes dejar una propina — es completamente opcional." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "WildCall est gratuit et sans publicité. Si l'app vous est utile, vous pouvez laisser un pourboire — c'est totalement optionnel." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "WildCall è gratuita e senza pubblicità. Se l'app ti è utile, puoi lasciare una mancia — è del tutto facoltativo." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O WildCall é gratuito e sem anúncios. Se o app for útil, você pode deixar uma gorjeta — é totalmente opcional." } }
      }
    },
    "WildCall filtre les appels." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "WildCall is filtering calls." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "WildCall está filtrando las llamadas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "WildCall filtre les appels." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "WildCall sta filtrando le chiamate." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O WildCall está filtrando chamadas." } }
      }
    },
    "WildCall ne collecte aucune donnée d'usage. Toutes les règles, packs et signatures sont traités localement sur votre appareil ; le seul appel réseau est la synchronisation des packs depuis le catalogue Octiplex." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "WildCall collects no usage data. All rules, packs, and signatures are processed locally on your device; the only network call is pack syncing from the Octiplex catalogue." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "WildCall no recopila datos de uso. Todas las reglas, paquetes y firmas se procesan localmente en tu dispositivo; la única llamada de red es la sincronización de paquetes desde el catálogo de Octiplex." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "WildCall ne collecte aucune donnée d'usage. Toutes les règles, packs et signatures sont traités localement sur votre appareil ; le seul appel réseau est la synchronisation des packs depuis le catalogue Octiplex." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "WildCall non raccoglie alcun dato d'uso. Tutte le regole, i pack e le firme vengono elaborati localmente sul tuo dispositivo; l'unica chiamata di rete è la sincronizzazione dei pack dal catalogo Octiplex." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O WildCall não coleta nenhum dado de uso. Todas as regras, packs e assinaturas são processados localmente no seu dispositivo; a única chamada de rede é a sincronização dos packs a partir do catálogo Octiplex." } }
      }
    },

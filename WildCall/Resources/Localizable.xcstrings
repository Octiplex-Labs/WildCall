        "it" : { "stringUnit" : { "state" : "translated", "value" : "La chiave dell'editore differisce dal pin esistente (%@). Rifiutato per sicurezza." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A chave do editor difere do pin existente (%@). Recusado por segurança." } }

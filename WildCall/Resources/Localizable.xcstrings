    "Terminez par `*` pour bloquer une famille de numéros : `0162*` couvre tous les numéros commençant par 01 62 (jusqu'à 1 000 000 de numéros par motif).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End with `*` to block a whole family of numbers: `0162*` covers every number starting with 01 62 (up to 1,000,000 numbers per pattern)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina con `*` para bloquear una familia de números: `0162*` cubre todos los números que empiezan por 01 62 (hasta 1 000 000 de números por patrón)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez par `*` pour bloquer une famille de numéros : `0162*` couvre tous les numéros commençant par 01 62 (jusqu'à 1 000 000 de numéros par motif)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina con `*` per bloccare un'intera famiglia di numeri: `0162*` copre tutti i numeri che iniziano con 01 62 (fino a 1 000 000 di numeri per schema)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

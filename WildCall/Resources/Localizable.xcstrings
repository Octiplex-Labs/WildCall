    "Ce pack n'est pas signé par Octiplex. Avant d'installer, vérifiez que cette empreinte correspond bien à celle publiée hors-bande par l'éditeur :" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This pack is not signed by Octiplex. Before installing, verify that this fingerprint matches the one published out-of-band by the publisher:" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Este paquete no está firmado por Octiplex. Antes de instalar, verifica que esta huella coincida con la publicada fuera de banda por el editor:" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce pack n'est pas signé par Octiplex. Avant d'installer, vérifiez que cette empreinte correspond bien à celle publiée hors-bande par l'éditeur :" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo pack non è firmato da Octiplex. Prima di installare, verifica che questa impronta corrisponda a quella pubblicata fuori canale dall'editore:" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Este pack não foi assinado pela Octiplex. Antes de instalar, verifique que esta impressão digital corresponde à publicada fora de banda pelo editor:" } }
      }
    },
    "Cette empreinte doit correspondre à celle publiée sur la page du projet. Si elle ne correspond pas, votre build a été modifié." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This fingerprint must match the one published on the project page. If it doesn't match, your build has been tampered with." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta huella debe coincidir con la publicada en la página del proyecto. Si no coincide, tu compilación ha sido alterada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette empreinte doit correspondre à celle publiée sur la page du projet. Si elle ne correspond pas, votre build a été modifié." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Questa impronta deve corrispondere a quella pubblicata sulla pagina del progetto. Se non corrisponde, la tua build è stata alterata." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Esta impressão digital deve corresponder à publicada na página do projeto. Se não corresponder, sua build foi alterada." } }
